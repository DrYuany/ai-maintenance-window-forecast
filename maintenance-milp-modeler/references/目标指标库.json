{
  "版本": "1.0",
  "说明": "第一阶段目标语义目录；支持状态不代表每个业务编译器均已接线。",
  "指标": [
    {"编号":"OBJ-001","名称":"完成任务数","类别":"检修产出","方向":"最大化","定义":"完成的唯一部件维修任务数","单位":"项","数据依赖":["维修任务","候选完工时刻"],"状态":"模板已支持"},
    {"编号":"OBJ-002","名称":"高严重完成数","类别":"检修产出","方向":"最大化","定义":"完成的高严重等级任务数","单位":"项","数据依赖":["维修任务","严重等级"],"状态":"模板已支持"},
    {"编号":"OBJ-003","名称":"中严重完成数","类别":"检修产出","方向":"最大化","定义":"完成的中严重等级任务数","单位":"项","数据依赖":["维修任务","严重等级"],"状态":"模板已支持"},
    {"编号":"OBJ-004","名称":"低严重完成数","类别":"检修产出","方向":"最大化","定义":"完成的低严重等级任务数","单位":"项","数据依赖":["维修任务","严重等级"],"状态":"模板已支持"},
    {"编号":"OBJ-005","名称":"总经济成本","类别":"经济","方向":"最小化","定义":"用户启用费用项之和，发电机会损失口径须明示","单位":"元","数据依赖":["费用参数","电价","风速/功率曲线","维修时长"],"状态":"模板已支持"},
    {"编号":"OBJ-006","名称":"最后完工时间","类别":"时间","方向":"最小化","定义":"所有已选任务中的最晚完工时刻","单位":"规划基点后分钟","数据依赖":["候选完工时刻"],"状态":"模板已支持"},
    {"编号":"OBJ-007","名称":"完工时间和","类别":"时间","方向":"最小化","定义":"已选任务完工时刻之和","单位":"任务·分钟","数据依赖":["候选完工时刻"],"状态":"模板已支持"},
    {"编号":"OBJ-008","名称":"分项直接费用","类别":"经济","方向":"最小化","定义":"船租、人工、备件等显式启用费用项","单位":"元","数据依赖":["费用率","资源用量"],"状态":"通用线性可组合"},
    {"编号":"OBJ-009","名称":"发电机会损失","类别":"经济/运行影响","方向":"最小化","定义":"逐时未发电量乘电价后求和","单位":"元","数据依赖":["风速","功率曲线","故障降额","电价","时段"],"状态":"通用线性可组合","备注":"固定数据系数；避免故障降额与检修停机重复计损。"},
    {"编号":"OBJ-010","名称":"逾期任务量","类别":"服务/时间","方向":"最小化","定义":"超过确认期限仍未完成的任务数或加权量","单位":"项/加权项","数据依赖":["期限","完成决策"],"状态":"候选待定义"},
    {"编号":"OBJ-011","名称":"跨窗口积压量","类别":"服务/时间","方向":"最小化","定义":"规划期末允许延期但尚未完成的任务量","单位":"项/加权项","数据依赖":["任务范围","窗口","完成决策"],"状态":"候选待定义"},
    {"编号":"OBJ-012","名称":"方案变更量","类别":"稳定性","方向":"最小化","定义":"相对冻结基准方案改变的决策数","单位":"项","数据依赖":["基准方案","本次决策"],"状态":"通用线性可组合"},
    {"编号":"OBJ-013","名称":"窗口负荷不均衡","类别":"稳定性/资源","方向":"最小化","定义":"窗口工作量差异；必须选定最大差或绝对偏差等口径","单位":"小时/人时","数据依赖":["任务工时","窗口分配"],"状态":"候选待定义"},
    {"编号":"OBJ-014","名称":"平均成本/产出比","类别":"比率目标","方向":"按需求","定义":"决策相关成本与任务数/产出之比","单位":"元/项等","数据依赖":["成本","完成决策"],"状态":"需非线性扩展","备注":"不得直接伪装成线性目标；需验证变换条件。"},
    {"编号":"OBJ-015","名称":"故障风险损失","类别":"风险","方向":"最小化","定义":"按校准概率、后果损失和暴露时间计算的预期风险","单位":"元或风险单位","数据依赖":["失效概率","后果","运行状态","持续时间"],"状态":"候选待定义","备注":"不得与发电机会损失重复计价。"}
  ]
}
